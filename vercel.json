{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "echo edge-proxy",
  "buildCommand": "node -e \"require('fs').mkdirSync('public',{recursive:true})\"",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "https://medipick-api.onrender.com/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Medipick-Edge", "value": "vercel-lexid" }
      ]
    }
  ]
}
