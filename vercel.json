{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "medipick",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "https://medipick-api.onrender.com/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Medipick-Edge", "value": "vercel-lexid" }
      ]
    }
  ]
}
