# 외부에 서비스할 경우 필수 변경. 실제 secret/keys는 파일에 저장·커밋하지 말 것.
MEDIPICK_HOST=127.0.0.1
MEDIPICK_PORT=8765
MEDIPICK_ADMIN_PASSWORD=SET_A_LONG_UNIQUE_PASSWORD
MEDIPICK_SECRET=SET_A_RANDOM_64_BYTE_SECRET
MEDIPICK_COOKIE_SECURE=1
MEDIPICK_DB=./data/medipick.sqlite3
# Optional: after analytics consent banner acceptance, events go to GA4
MEDIPICK_GA_ID=G-XXXXXXXXXX
# DATA_GO_KR_SERVICE_KEY=PUBLIC_DATA_SERVICE_KEY
# YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
# MEDIPICK_NOTIFICATION_WEBHOOK=https://your-approved-message-provider.example/api/message
# MEDIPICK_NOTIFICATION_TOKEN=YOUR_PROVIDER_SECRET
# Optional, per-request user consent required before sending any search phrase
# OPENAI_API_KEY=YOUR_API_KEY
# MEDIPICK_AI_MODEL=gpt-5.1 # confirm account model availability

# MEDIPICK V2 - Google Maps JavaScript key (restrict by HTTP referrer and API type)
# Requires enabling Maps JavaScript API, a billing-capable Google Cloud project.
# Keep empty for the offline demo that still returns subscriber-only nearby distance results.
GOOGLE_MAPS_BROWSER_KEY=
# Public Blogger via Atom works without Blogger OAuth; production OAuth not implemented.

# Private Google Places (New) server key, never expose in browser: restrict by server origin/API.
GOOGLE_PLACES_SERVER_KEY=

# MEDIPICK V3.2 · Google account + Blogger (Google Cloud OAuth Web application)
# Registered redirect URI MUST exactly equal this value.
# Local example: http://127.0.0.1:8765/api/google/connect/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/api/google/connect/callback
# Production: HTTPS domain, verified consent screen, restricted scopes and credentials.
# Admin must explicitly select a verified doctor profile before linking Google account.

# MEDIPICK V3.2 · Toss Payments V2 SDK + merchant subscription checkout
# Requires the business merchant agreement and API keys from Toss Payments.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
MEDIPICK_ENABLE_REAL_PAYMENTS=0
# Never enter patient/treatment fees as a merchant-subscription order.

# MEDIPICK v3.3: use only real approved provider template IDs for live sends.
MEDIPICK_TEMPLATE_BOOKING_REQUESTED=
MEDIPICK_TEMPLATE_BOOKING_CONFIRMED=
MEDIPICK_TEMPLATE_BOOKING_DECLINED=
MEDIPICK_TEMPLATE_BOOKING_CANCELLED=
