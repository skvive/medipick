{
  "name": "medipick",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "sync-public": "node scripts/sync-public.mjs",
    "dev": "npm run sync-public && next dev",
    "build": "npm run sync-public && next build",
    "start": "next start",
    "db:migrate": "node scripts/run-sql.mjs sql/001_schema.sql && node scripts/run-sql.mjs sql/002_extensions.sql && node scripts/run-sql.mjs sql/003_public_hospital_catalog.sql && node scripts/run-sql.mjs sql/004_catalog_marketing_tiers.sql",
    "db:seed": "node scripts/seed-neon.mjs",
    "catalog:import": "python scripts/import-public-hospital-catalog.py",
    "catalog:import:dropbox": "node scripts/run-catalog-import-dropbox.mjs",
    "catalog:import:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/import-catalog-local.ps1",
    "content:linkr": "node scripts/build-livelinkr-manifest.mjs && node scripts/import-livelinkr-content.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.6.0-beta",
    "@neondatabase/serverless": "^0.10.4",
    "next": "^16.4.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@better-auth/core": "1.7.16",
    "@better-auth/drizzle-adapter": "1.7.16",
    "@better-auth/kysely-adapter": "1.7.16",
    "@better-auth/memory-adapter": "1.7.16",
    "@better-auth/mongo-adapter": "1.7.16",
    "@better-auth/passkey": "1.7.16",
    "@better-auth/prisma-adapter": "1.7.16",
    "@better-auth/telemetry": "1.7.16",
    "better-auth": "1.7.16",
    "postcss": "8.5.28",
    "zod": "4.6.6"
  }
}
